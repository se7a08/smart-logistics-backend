@using SmartLogistics.Application.DTOs.Shipments
@model ShipmentDto
@{
    ViewData["Title"] = Model.TrackingNumber;
    var history = ViewData["History"] as List<ShipmentStatusHistoryDto> ?? new();
}

<a asp-action="Index" class="btn btn-link ps-0">&larr; Back to shipments</a>
@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}
<h2 class="mb-3">@Model.TrackingNumber <span class="badge bg-secondary fs-6">@Model.Status</span></h2>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5>Recipient</h5>
                <dl class="row mb-0">
                    <dt class="col-4">Name</dt>
                    <dd class="col-8">@Model.RecipientName</dd>
                    <dt class="col-4">Phone</dt>
                    <dd class="col-8">@Model.RecipientPhone</dd>
                    <dt class="col-4">Email</dt>
                    <dd class="col-8">@Model.RecipientEmail</dd>
                    <dt class="col-4">Address</dt>
                    <dd class="col-8">@Model.DeliveryAddress</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5>Shipment</h5>
                <dl class="row mb-0">
                    <dt class="col-5">From</dt>
                    <dd class="col-7">@Model.OriginWarehouseName</dd>
                    <dt class="col-5">To</dt>
                    <dd class="col-7">@Model.DestinationWarehouseName</dd>
                    <dt class="col-5">Driver</dt>
                    <dd class="col-7">@(Model.DriverName ?? "Unassigned")</dd>
                    <dt class="col-5">Weight</dt>
                    <dd class="col-7">@Model.Weight kg</dd>
                    <dt class="col-5">Declared value</dt>
                    <dd class="col-7">@Model.DeclaredValue.ToString("N2")</dd>
                    <dt class="col-5">Fragile</dt>
                    <dd class="col-7">@(Model.IsFragile ? "Yes" : "No")</dd>
                    <dt class="col-5">QR verified</dt>
                    <dd class="col-7">@(Model.QrVerified ? "Yes" : "No")</dd>
                    <dt class="col-5">Est. delivery</dt>
                    <dd class="col-7">@(Model.EstimatedDelivery?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
                    <dt class="col-5">Delivered at</dt>
                    <dd class="col-7">@(Model.DeliveredAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
@{
    var drivers = ViewData["Drivers"] as List<SmartLogistics.Application.Features.Drivers.Queries.DriverOptionDto> ?? new();
    var nextStatuses = Model.Status switch
    {
        "Pending" => new[] { "PickedUp", "Cancelled" },
        "PickedUp" => new[] { "InTransit", "Cancelled" },
        "InTransit" => new[] { "Delivered", "Cancelled" },
        _ => Array.Empty<string>()
    };
}

<div class="row g-3 mt-1">
    @if (Model.Status == "Pending")
    {
        <div class="col-md-6">
            <form asp-action="AssignDriver" asp-route-id="@Model.Id" method="post" class="card shadow-sm card-body">
                <h5>Assign driver</h5>
                <div class="input-group">
                    <select name="driverId" class="form-select" required>
                        <option value="">Select driver...</option>
                        @foreach (var d in drivers)
                        {
                            <option value="@d.Id" selected="@(d.Id == Model.DriverId)">@d.Name</option>
                        }
                    </select>
                    <button class="btn btn-primary">Assign</button>
                </div>
            </form>
        </div>
    }
    @if (nextStatuses.Length > 0)
    {
        <div class="col-md-6">
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="card shadow-sm card-body">
                <h5>Update status</h5>
                <div class="input-group mb-2">
                    <select name="status" class="form-select">
                        @foreach (var s in nextStatuses)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                    <button class="btn btn-success">Update</button>
                </div>
                <input name="notes" class="form-control" placeholder="Notes (optional)" />
            </form>
        </div>
    }
</div>
<h5 class="mt-4">Status history</h5>
<table class="table table-sm">
    <thead><tr><th>Date (UTC)</th><th>Status</th><th>Notes</th></tr></thead>
    <tbody>
        @foreach (var h in history)
        {
            <tr>
                <td>@h.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@h.Status</td>
                <td>@h.Notes</td>
            </tr>
        }
        @if (!history.Any())
        {
            <tr><td colspan="3" class="text-muted">No history yet.</td></tr>
        }
    </tbody>
</table>