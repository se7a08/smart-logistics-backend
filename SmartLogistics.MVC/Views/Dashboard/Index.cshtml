@model SmartLogistics.Application.DTOs.Dashboard.DashboardStatsDto
@{
    ViewData["Title"] = "Dashboard";
}

@functions {
    void Card(string title, int value, string color)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">@title</div>
                    <div class="fs-2 fw-bold text-@color">@value</div>
                </div>
            </div>
        </div>
    }
}

<h2 class="mb-4">Dashboard</h2>

<div class="row g-3">
    @{
        Card("Total shipments", Model.TotalShipments, "dark");
    }
    @{
        Card("Created today", Model.CreatedToday, "primary");
    }
    @{
        Card("Pending", Model.Pending, "secondary");
    }
    @{
        Card("In progress", Model.InProgress, "info");
    }
    @{
        Card("Delivered", Model.Delivered, "success");
    }
    @{
        Card("Delayed", Model.Delayed, "danger");
    }
    @{
        Card("Cancelled", Model.Cancelled, "warning");
    }
    @{
        Card("Active drivers", Model.ActiveDrivers, "primary");
    }
    @{
        Card("Active warehouses", Model.ActiveWarehouses, "primary");
    }
</div>