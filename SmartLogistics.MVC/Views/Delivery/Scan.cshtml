@using SmartLogistics.Application.DTOs.Shipments
@model ShipmentDto
@{
    ViewData["Title"] = "Scan " + Model.TrackingNumber;
}

<a asp-action="Index" class="btn btn-link ps-0">&larr; Back</a>
<h2>Confirm delivery: @Model.TrackingNumber</h2>
<p class="text-muted">@Model.RecipientName, @Model.DeliveryAddress</p>

@if (TempData["Error"] is string err)
{
     <div class="alert alert-danger">@err</div>
}

<div class="row g-3">
    <div class="col-md-6"><div id="reader" class="border rounded"></div></div>
    <div class="col-md-6">
        <form asp-action="Confirm" asp-route-id="@Model.Id" method="post" class="card card-body shadow-sm">
            <label class="form-label">Scanned code</label>
            <input id="qrCode" name="qrCode" class="form-control mb-2" required placeholder="Scan or paste the QR text" />
            <input name="notes" class="form-control mb-2" placeholder="Notes (optional)" />
            <button class="btn btn-success">Confirm delivery</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script>
        const scanner = new Html5Qrcode("reader");
        scanner.start({ facingMode: "environment" }, { fps: 10, qrbox: 220 },
            text => { document.getElementById("qrCode").value = text; scanner.stop(); },
            () => {}).catch(() => { document.getElementById("reader").innerHTML =
                "<p class='p-3 text-muted'>Camera unavailable. Paste the code instead.</p>"; });
    </script>
}
